{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/redmine-cli/schema/output.schema.json",
  "title": "redmine-cli output envelope",
  "type": "object",
  "required": ["ok"],
  "properties": {
    "ok": {
      "type": "boolean"
    },
    "data": true,
    "error": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "config_missing",
            "auth_missing",
            "auth_failed",
            "network_error",
            "timeout",
            "redmine_error",
            "not_found",
            "validation_failed",
            "ambiguous_name",
            "unknown_name",
            "unsupported_filter",
            "workflow_rejected",
            "conflict",
            "rate_limited",
            "permission_denied",
            "input_parse_error",
            "file_not_found",
            "cache_error",
            "internal_error"
          ]
        },
        "message": {
          "type": "string"
        },
        "hint": {
          "type": "string"
        },
        "details": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "meta": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string"
        },
        "defaults_used": {
          "type": "object"
        },
        "operation": {
          "type": "object",
          "properties": {
            "risk": {
              "type": "string",
              "enum": ["low", "medium", "high"]
            },
            "dry_run": {
              "type": "boolean"
            }
          },
          "additionalProperties": true
        },
        "cache": {
          "type": "object",
          "properties": {
            "metadata": {
              "type": "string",
              "enum": ["hit", "miss", "refreshed", "bypassed", "error"]
            },
            "refreshed": {
              "type": "boolean"
            },
            "age_seconds": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "pagination": {
      "type": "object",
      "properties": {
        "limit": {
          "type": "integer",
          "minimum": 0
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        },
        "total_count": {
          "type": "integer",
          "minimum": 0
        },
        "next_offset": {
          "type": "integer",
          "minimum": 0
        },
        "has_more": {
          "type": "boolean"
        },
        "returned": {
          "type": "integer",
          "minimum": 0
        },
        "truncated": {
          "type": "boolean"
        },
        "hint": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dry_run": {
      "type": "boolean"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "ok": {
            "const": true
          }
        }
      },
      "then": {
        "not": {
          "required": ["error"]
        }
      }
    },
    {
      "if": {
        "properties": {
          "ok": {
            "const": false
          }
        }
      },
      "then": {
        "required": ["error"]
      }
    }
  ],
  "additionalProperties": false
}

